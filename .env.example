# ==============================================
# MissionX — Environment Configuration Template
# ==============================================

# Server / API Port
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/missionx

# Authentication & Security
JWT_SECRET=your_jwt_super_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (Web Client)
CLIENT_ORIGIN=http://localhost:3000

# Next.js Public Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# Demo Seed Accounts (Overrides for seed script)
SEED_ADMIN_EMAIL=admin@missionx.edu
SEED_ADMIN_PASSWORD=AdminPass123!
SEED_STUDENT_EMAIL=student@missionx.edu
SEED_STUDENT_PASSWORD=StudentPass123!
